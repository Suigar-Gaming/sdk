{
	"name": "@suigar/ts-sdks",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^22.18.0 || >=24.0.0",
			"onFail": "warn"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba",
			"onFail": "warn"
		}
	},
	"scripts": {
		"prepare": "husky",
		"build": "turbo run build",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"changeset": "changeset",
		"changeset:beta:enter": "changeset pre enter beta",
		"changeset:beta:exit": "changeset pre exit",
		"changeset:version": "changeset version",
		"release": "turbo run build:ci --filter='./packages/*' && changeset publish",
		"oxlint": "oxlint .",
		"oxlint:fix": "oxlint . --fix",
		"prettier": "prettier --check --ignore-unknown .",
		"prettier:fix": "prettier --write --ignore-unknown .",
		"lint": "pnpm run oxlint && pnpm run prettier",
		"lint:fix": "pnpm run oxlint:fix && pnpm run prettier:fix"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"oxlint": "^1.73.0",
		"oxlint-tsgolint": "^0.24.0",
		"prettier": "catalog:tooling",
		"turbo": "^2.10.4"
	}
}
